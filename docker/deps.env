# Pinned versions for the combined build image.
# Used by BOTH the Windows and Linux portable builds.
# Bumping Qt is a one-line change here.

QT_VERSION=6.8.3

# aqt architecture identifiers (differ from filesystem directory names).
QT_ARCH_LINUX=linux_gcc_64
QT_ARCH_WINDOWS=win64_mingw

# Qt modules to install.
QT_MODULES_LINUX="qtmultimedia qtimageformats"
QT_MODULES_WINDOWS="qtmultimedia qtimageformats"

# Cross-compiler toolchain (AmanoTeam prebuilt, Linux-hosted).
# Provides GCC 16.2.1 targeting Win64 — ABI-compatible with Qt 6.8.3/GCC 13.1.
MINGW_CROSS_URL="https://github.com/AmanoTeam/mingw-gcc-cross/releases/download/gcc-16/x86_64-unknown-linux-gnu.tar.xz"
MINGW_CROSS_VERSION="gcc-16"

# FFmpeg headers — same version as Qt's bundled FFmpeg 7.x (libavcodec.so.61).
# Qt does NOT ship headers, so we download matching upstream headers.
# ABI is stable within a major version: 7.1.1 headers against Qt's 7.x .so is defined.
FFMPEG_VERSION=7.1.1
FFMPEG_SRC_URL="https://ffmpeg.org/releases/ffmpeg-7.1.1.tar.xz"
FFMPEG_SRC_SHA256=733984395e0dbbe5c046abda2dc49a5544e7e0e1e2366bba849222ae9e3a03b1
